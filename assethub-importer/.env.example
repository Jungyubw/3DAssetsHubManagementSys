# Copy to .env and fill in. Never commit .env.
# AssetHub script auth (method pending dev team confirmation, see docs/SPEC.md)
ASSETHUB_API_BASE=https://assethub-api.bigbenett.com
ASSETHUB_TOKEN=

# Google OAuth desktop client file (downloaded from Google Cloud Console)
GOOGLE_CLIENT_SECRET_FILE=client_secret.json
GOOGLE_TOKEN_FILE=token.json

# Google Sheet for the ledger ("AssetHub 등록 원장")
LEDGER_SHEET_ID=
